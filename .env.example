# Steel Browser on Railway — environment variables.
# Only STEEL_API_KEY is on the deploy form (generated). Everything else
# is baked into the image or derived at boot by entrypoint.sh.
# Copy this file to .env only for local reference — do not commit real keys.

# Required (generated per deploy by the template).
STEEL_API_KEY=your-generated-api-key

# Derived at boot from RAILWAY_PUBLIC_DOMAIN (do not set manually):
# DOMAIN, USE_SSL=true

# Baked into the image:
# LOG_STORAGE_ENABLED=true
# LOG_STORAGE_PATH=/data/logs/browser-logs.duckdb
# PORT is split at boot: Steel listens internally on 12732, the nginx
# gateway listens on Railway's injected PORT.

# Optional upstream variables (Steel api/src/env.ts) — set in the
# Railway variables panel only if you need them; defaults are the
# upstream defaults:
# PROXY_URL=                 Proxy Steel routes browser traffic through (e.g. user:pass@host:port)
# DEFAULT_HEADERS={}         JSON object of headers added to every browser request
# CHROME_EXECUTABLE_PATH=    Custom Chrome/Chromium binary path (image ships /usr/bin/chromium)
# CHROME_HEADLESS=true       Headless mode (default true)
# CHROME_ARGS=               Extra space-separated Chrome flags
# FILTER_CHROME_ARGS=        Space-separated Chrome flags to strip from Steel's defaults
# DISABLE_CHROME_SANDBOX=    Set to true only if Chromium cannot start in the container
# DEFAULT_TIMEZONE=          Timezone for browser sessions (e.g. America/New_York)
# SKIP_FINGERPRINT_INJECTION= Set to true to disable Steel's fingerprint injection
# ENABLE_COMMANDS_API=       Set to true to enable the experimental Commands API
# ENABLE_CDP_LOGGING=        Set to true to log CDP traffic
# ENABLE_VERBOSE_LOGGING=    Set to true for verbose Fastify logging
# LOG_LEVEL=debug            Log level (development logging only)
# KILL_TIMEOUT=0             ms to wait for a session browser to die before force-killing
